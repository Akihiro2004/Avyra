[Unit]
Description=Avyra Listen Together server
After=network-online.target
Wants=network-online.target

[Service]
User=avyra
ExecStart=/opt/avyra-jam/server
Restart=always
RestartSec=2

# Caddy terminates TLS on 443 and forwards X-Forwarded-For; port 8000 stays
# closed to the internet (only 80/443 are opened by setup.sh).
Environment=PORT=8000
Environment=JAM_HOST=127.0.0.1
Environment=JAM_TRUST_PROXY=true
Environment=JAM_MAX_MEMBERS=5
Environment=JAM_STATE_HEARTBEAT_MS=5000
Environment=JAM_MAX_UPCOMING_QUEUE=25
Environment=JAM_MAX_PARTIES=200
Environment=JAM_CREATE_RATE_PER_MINUTE=2
Environment=JAM_CONNECTION_IDLE_MS=900000
# Per-server settings written by setup.sh — notably JAM_ANDROID_CERT_SHA256,
# which turns on /.well-known/assetlinks.json. Anything here overrides the
# lines above.
EnvironmentFile=-/etc/avyra-jam.env

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
