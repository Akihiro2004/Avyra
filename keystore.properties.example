# Copy this file to keystore.properties and fill in the values. The real file
# is ignored by Git and must never be committed.
#
# One way to create a key from the project root is:
#
# keytool -genkeypair -v -keystore avyra-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias avyra
#
# Back up the key and passwords somewhere safe. If the release key is lost,
# future builds cannot update an app installed with that key.

storeFile=avyra-release.jks
storePassword=
keyAlias=avyra
keyPassword=
